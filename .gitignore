# Dependencies
node_modules/

# Build output — generated by `npm run build`, deployed to Netlify from dist/
dist/
dist-ssr/

# Local visitor-counter state written by the dev/preview server
.data/

# Downloadable deck bundle — generated from the source deck. The distributable
# files are tracked so GitHub can serve them as direct download links; scratch
# build output and duplicated slide images stay out of Git.
/download/*
!/download/Bangladesh-Hyper-Deck.zip
!/download/Bangladesh-Hyper-Deck.pdf
!/download/Bangladesh-Hyper-Deck.html
!/download/README.txt

# Local deck-generation helpers (screenshots, offline single-file build)
/.deck-tools/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Environment — the canonical origin comes from VITE_SITE_URL (see src/site.js).
# These files hold per-deploy values and must not be committed.
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
